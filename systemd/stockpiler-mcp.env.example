# Stockpiler MCP environment — copy to /etc/stockpiler-mcp.env
# install-mcp-server.sh will install this file only if it does not already exist.

STOCKPILER_ROOT=/mnt/drop/stockpiler-data
STOCKPILER_MCP_HOST=0.0.0.0
STOCKPILER_MCP_PORT=1337
STOCKPILER_MCP_MODE=dev

# --- Production (TLS + API keys) ---
# STOCKPILER_MCP_MODE=production
# STOCKPILER_TLS_CERT=/etc/stockpiler/tls/fullchain.pem
# STOCKPILER_TLS_KEY=/etc/stockpiler/tls/privkey.pem
# STOCKPILER_API_KEYS=replace-me-with-a-long-random-secret,optional-second-key
